# Backend Environment Variables
# Copy this file to .env for local development
# For production, set these in your hosting platform (Railway, Render, Fly.io, etc.)

# Database URL (auto-configured on Railway/Render/Fly.io)
# Local development: sqlite:///./standard_io.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# CORS Origins (comma-separated)
# Example: https://your-app.vercel.app,https://your-app.onrender.com
CORS_ORIGINS=

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24 hours

# Optional: SQL query logging
# SQL_ECHO=false