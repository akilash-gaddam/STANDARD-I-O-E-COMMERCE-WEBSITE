# Frontend Environment Variables
# Copy this file to .env.local for local development
# For production, set these in your hosting platform (Vercel, Netlify, etc.)

# API Base URL - REQUIRED for production
# Example: https://your-api.up.railway.app/api
# For local development with backend on port 8000, Vite proxy handles this automatically
VITE_API_BASE_URL=

# Optional: Enable debug logging
# VITE_DEBUG=true